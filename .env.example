EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: MapLibre style URL. Defaults to OpenFreeMap's free "liberty"
# style (no API key needed) if left unset. For production, consider your
# own style — e.g. from MapTiler (https://www.maptiler.com/) —
# so you're not depending on someone else's rate limits:
# EXPO_PUBLIC_MAPLIBRE_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
EXPO_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
